        "chunk_id": "01_Meridian_Analytics_Company_Overview-0001",
        "quote": "The top ten customers account for approximately 61% of ARR.",
        "required_terms": [
          "top ten",
          "61%",
          "ARR"
        ]
      },
      {
        "id": "quote_supports_contract_termination_claim",
