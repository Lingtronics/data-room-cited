LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-chat
CONTEXT_MODEL_ID=deepseek-chat
RERANK_MODEL_ID=deepseek-chat
ANSWER_MAX_TOKENS=5000
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
DATA_DIR=data
INDEX_DIR=index
EXPORT_DIR=exports
SEMANTIC_DIR=semantic
TAXONOMY_DIR=taxonomy
SEMANTIC_DEFINITIONS_PATH=semantic/business_concepts.json
TAXONOMY_PATH=taxonomy/diligence_taxonomy.ttl
TOP_K=6
TOP_K_INITIAL=18
CHUNK_TARGET_CHARS=1800
CHUNK_OVERLAP_CHARS=250
RERANK_ENABLED=true
CONTEXTUAL_RETRIEVAL_ENABLED=false
CONTEXT_GENERATION_WORKERS=4
AGENT_MAX_TOOL_TURNS=6
MULTI_AGENT_ENABLED=true
MULTI_AGENT_MAX_MODEL_CALLS=6
MULTI_AGENT_MAX_TOOL_CALLS=50
MULTI_AGENT_MAX_RETRIES=1
MULTI_AGENT_MAX_ELAPSED_SECONDS=180
MULTI_AGENT_MAX_CONTEXT_CHARS=40000
RAG_CORE_BASE_URL=http://127.0.0.1:8765
MCP_GATEWAY_PORT=8787
MCP_DEFAULT_SCOPES=documents:read,citations:verify
MCP_AUTH_REQUIRED=false
MCP_ALLOW_DEV_TOKENS=true
MCP_AUTH_AUDIENCE=http://127.0.0.1:8787/mcp
MCP_AUTH_ISSUER=data-room-cited-local
MCP_JWKS_URL=
MCP_DEV_JWT_SECRET=local-dev-only-change-me
MCP_DEFAULT_WORKSPACE_ID=local
MCP_APPROVAL_REQUIRED=true
OTEL_SERVICE_NAME=data-room-cited
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
DOCUMENT_SOURCE_TYPE=local
LOCAL_SOURCE_DIR=data
SOURCE_MANIFEST_PATH=index/source_manifest.json
S3_SOURCE_BUCKET=
S3_SOURCE_PREFIX=
S3_ENDPOINT_URL=

# Voice M1: opt-in synthetic gateway/core profile. See docs/voice-agent-setup.md.
# Ordinary defaults above are deliberately retained; voice mode refuses them.
VOICE_FEATURE_ENABLED=false
VOICE_READ_ONLY_DEMO=true
VOICE_FIXTURE_DATA_DIR=
VOICE_FIXTURE_INDEX_DIR=
MCP_GATEWAY_HOST=127.0.0.1
RAG_CORE_HOST=127.0.0.1
RAG_CORE_PORT=8767
# Voice M2: local session/evidence API. Credentials stay server-side.
VOICE_API_HOST=127.0.0.1
VOICE_API_PORT=8790
# Voice M3: public UI settings only; never put secrets under a VITE_ prefix.
VOICE_WEB_HOST=127.0.0.1
VOICE_WEB_PORT=5173
VOICE_WEB_MODE=mock
VOICE_API_ORIGIN=http://127.0.0.1:8790
# Browser session timer (1–15 minutes); not a provider billing control.
VOICE_MAX_SESSION_MINUTES=15
VOICE_ALLOWED_ORIGINS=http://localhost:5173
# Global request budget per minute and issuance attempts per API process.
VOICE_REQUESTS_PER_MINUTE=30
VOICE_MAX_SESSIONS=10
VOICE_UPSTREAM_TIMEOUT_MS=8000
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VOICE_MCP_BASE_URL=http://127.0.0.1:8787/mcp
VOICE_MCP_SERVICE_TOKEN=
# M4 preparation only. Set these only after approval for a temporary HTTPS route.
# Exact origin, no /mcp suffix. Expiry must be UTC and within 30 minutes of startup.
# Blank defaults preserve direct loopback-only access. The gateway still binds 127.0.0.1.
VOICE_MCP_EXTERNAL_ORIGIN=
VOICE_MCP_EXTERNAL_EXPIRES_AT=
# Empty permits absent Origin only on the external route; no wildcards.
VOICE_MCP_EXTERNAL_ALLOWED_ORIGINS=
